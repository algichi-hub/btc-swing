# Local development values only. Do not use this file as production secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8005
REFRESH_INTERVAL_SECONDS=300
DATABASE_PATH=data/btc_swing_trade.db
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8005,http://localhost:8005
AUTH_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Generate a unique secret via secret manager before production.
AUTH_CSRF_SECRET=
TELEGRAM_ENABLED=false
