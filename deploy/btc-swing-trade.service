[Unit]
Description=BTC Swing Trade
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set these values for your Raspberry Pi user/group before installing the service.
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=/opt/btc_swing_trade
EnvironmentFile=/opt/btc_swing_trade/.env
Environment=UVICORN_WORKERS=1
ExecStart=/opt/btc_swing_trade/scripts/run_linux.sh
Restart=on-failure
RestartSec=5

# Allow writing runtime SQLite files while keeping the rest read-only.
ReadWritePaths=/opt/btc_swing_trade/data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
